NODE_ENV=development
HOST=0.0.0.0
PORT=8787
# In production, set the exact public origin, e.g. https://inspection.example.com
APP_ORIGIN=http://localhost:8787
DB_FILE=./api/data/pakdasht.sqlite
SESSION_TTL_DAYS=7
# Demo seed accounts/data are enabled only for development by default.
DEMO_MODE=true
# Registration is enabled in development and disabled by default in production.
ALLOW_REGISTRATION=true
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ORGANIZATION_TIMEZONE=Asia/Tehran
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
MAX_BODY_BYTES=1000000
# For a future PostgreSQL deployment, use DATABASE_URL and install/configure a PostgreSQL driver.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Optional local demo seed credentials (never use in production).
DEMO_MANAGER_PASSWORD=replace-with-a-long-local-only-password
DEMO_INSPECTOR_PASSWORD=replace-with-a-long-local-only-password
